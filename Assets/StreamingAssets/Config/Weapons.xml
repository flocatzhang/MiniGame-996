<?xml version="1.0" encoding="utf-8"?>
<!--
  Three weapons, three code paths, twelve behaviours. Every quality row states only what it changes
  and inherits the rest from the tier below, so "blue adds a second needle" is readable as one line
  instead of being buried in a full copy of every number.

  Reading a tier: green is the complete definition, blue/purple/orange are deltas on top of it.

  damage = (baseDamage + atk * atkCoef) * qualityCoef, applied once per hit. With six slots the hit
  count multiplies fast, which is why every rate here looks slow in isolation. Raising a rate by 30
  percent raises the whole build by 30 percent, not one weapon.

  knockback is the distance in units the target is pushed, not an impulse. Each enemy carries its own
  internal cooldown on the debuff (knockbackCd in Enemies.xml), so raising these numbers changes how
  far one push travels and never how often it lands. Before that cooldown existed the pushes stacked,
  and an enemy under fire from six slots could be held off the player forever.
-->
<Weapons>

  <!--
    订书机. The one weapon that reaches. Needles fly parallel rather than in a fan: a spread would
    make the three needle tier less accurate than the one needle tier, which is the opposite of what
    an upgrade is supposed to mean.
  -->
  <Weapon id="stapler" name="订书机" type="ProjectileLauncher"
          baseDamage="6" atkCoef="0.6" rate="1.1" viewId="v_proj">
    <Tier q="green"  projCount="1" spacing="0.30" pierce="0" range="6.5" projSpeed="13" knockback="0.4" />
    <Tier q="blue"   projCount="2" projSpeed="14" />
    <Tier q="purple" projCount="3" pierce="1" range="7.5" />
    <!-- The pin is the actual orange payoff. Two seconds of a stationary Deadline changes a fight. -->
    <Tier q="orange" pierce="2" projSpeed="16" pinSeconds="0.6" knockback="0.6" />
  </Weapon>

  <!--
    键盘. Commits to a coordinate, not a target, so a fast enemy walking out from under it is
    feedback the player can read rather than a miss that needs correcting. Short lock range on
    purpose: this is the weapon that answers a crowd already on top of you.
  -->
  <Weapon id="keyboard" name="键盘" type="GroundAoe"
          baseDamage="14" atkCoef="0.9" rate="0.65" windup="0.35" viewId="v_slam">
    <Tier q="green"  lockRange="3.0" blastRadius="1.5" slams="1" knockback="0.8" />
    <!--
      slowSeconds has to stay under the 1.54s attack interval. At the 1.5s it used to be hard coded
      at, the next strike renewed the slow before it lapsed and every enemy in range of a keyboard
      was slowed permanently. 0.8 leaves half the cycle at full speed, which is what makes the slow
      readable as something that happened rather than as the enemy's real speed.
    -->
    <Tier q="blue"   blastRadius="2.0" slowPct="25" slowSeconds="0.8" />
    <Tier q="purple" lockRange="3.6" slams="2" secondSlamPct="60" />
    <!--
      Ctrl+A. Every fifth strike abandons the locked target, centres on the player and sweeps
      selectAllRadius, at half a normal strike and carrying neither the knockback nor the slow.

      6.0 against a camera half extent of 9.78 x 5.5. That is deliberately taller than the screen and
      well short of its width: the sweep clears everything closing in and leaves the left and right
      edges alive, so it reads as a big attack with an outside rather than as the screen resetting.
      It used to bill every enemy alive with no radius at all, which left the other five slots with
      nothing to shoot every fifth attack.

      selectAllSharedCd is shared by every slot holding a keyboard, not per slot. One orange keyboard
      reaches its fifth strike every 7.7s at zero haste, so a lone keyboard is untouched by a 4s
      cooldown until haste gets high: at the 99 cap the interval halves and five strikes take 3.85s,
      which is where even one keyboard starts being held a strike. Six of them land six sweeps inside
      two seconds, which is what this exists for. A blocked slot holds its sweep for the next strike
      rather than forfeiting it, so the cost of the cooldown is delay and never a lost sweep.
    -->
    <Tier q="orange" blastRadius="2.4" selectAllEvery="5" selectAllPct="50"
          selectAllRadius="6.0" selectAllSharedCd="4" knockback="1.2" />
  </Weapon>

  <!--
    工牌. No cooldown and no projectile: the badges exist while the weapon is equipped, so the damage
    is paid for in proximity instead of in time. The per card per target cooldown is not a balance
    knob, it is what stops an enemy pressed against the player from being judged every frame.
  -->
  <Weapon id="badge" name="工牌" type="Orbit"
          baseDamage="10" atkCoef="0.5" sameTargetCd="0.9" viewId="v_orbit">
    <Tier q="green"  orbitCount="1" orbitRadius="1.8" orbitDegPerSec="150" knockback="0.5" />
    <Tier q="blue"   orbitCount="2" orbitDegPerSec="175" />
    <Tier q="purple" orbitCount="3" orbitRadius="2.1" orbitDegPerSec="200" />
    <!-- Orange links the badges into one ring, turning four points of contact into a closed curve. -->
    <Tier q="orange" orbitCount="4" orbitDegPerSec="220" tetherDamagePct="35" />
  </Weapon>

  <!--
    The coefficient hits both the flat and the atk term, which is what makes an orange upgrade feel
    like a tier change rather than a small number going up. Orange at 2.1 is deliberately short of
    double green on the flat term alone: the tier's own behaviour change is the rest of the payoff.

    Cards read this same table, so these four numbers are the only quality ladder in the game.
  -->
  <Quality green="1.0" blue="1.25" purple="1.6" orange="2.1" />

</Weapons>
